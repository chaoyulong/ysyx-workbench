diff --git a/perip/psram/psram.v b/perip/psram/psram.v
index d9bdd882..634098d3 100644
--- a/perip/psram/psram.v
+++ b/perip/psram/psram.v
@@ -4,6 +4,183 @@ module psram(
   inout [3:0] dio
 );
 
-  assign dio = 4'bz;
+  wire reset = ce_n;
 
+  typedef enum [2:0] { cmd_t, addr_t, r_data_t, w_data_t, delay_t, err_t } state_t;   //读ram时需要进入delay_t状态延迟6个时钟
+  reg  [2:0]  state;
+  reg  [7:0]  counter;
+  reg  [7:0]  cmd;
+  reg  [23:0] addr;
+  reg  [31:0] data;   
+  wire [31:0] rdata;
+  wire [31:0] wdata;          // spi读出的数据
+  reg  [31:0] wdata_real;     // 实际要写入的数据 (因为需要对齐)
+  reg  [3:0]  wmask;          // 掩码
+  reg         qpi_mode;       // 是否进入qpi模式, 0: qspi，1: qpi
+
+  wire valid = (cmd == 8'hEB) && (state == addr_t) && (counter == 8'd20);     // 读，在地址写完之后即可开始读，但是数据输出需要延迟6个时钟
+                                                                              // 写，需要在数据写完之后才能开始,而且不确定字长，所以选择片选的上升沿进行写入,与valid无关
+
+  wire [31:0] rwaddr = (state == addr_t) ? {8'b0, addr[19:0], dio} : {8'b0, addr[23:0]};  // 读/写的地址
+
+  always@(posedge sck or posedge reset) begin
+    if(reset) begin
+      wdata_real <= 32'b0;
+      wmask <= 4'b0;
+    end
+    else if(state == w_data_t) begin // 可能的数据结束点
+      if(counter == 8'd4) begin     //b
+        wdata_real <= {4{wdata[31:24]}};
+        case(rwaddr[1:0])
+          2'b00:    wmask <= 4'b0001;
+          2'b01:    wmask <= 4'b0010;
+          2'b10:    wmask <= 4'b0100;
+          2'b11:    wmask <= 4'b1000;
+          default:  wmask <= 4'b0000; 
+        endcase
+      end
+      else if(counter == 8'd12) begin     //h
+        wdata_real <= {2{wdata[31:16]}};
+        case(rwaddr[1:0])
+          2'b00:    wmask <= 4'b0011; 
+          2'b10:    wmask <= 4'b1100; 
+          default:  wmask <= 4'b0000; 
+        endcase
+      end
+      else if(counter == 8'd28) begin     //w
+        wdata_real <= wdata;
+        case(rwaddr[1:0])
+          2'b00:    wmask <= 4'b1111; 
+          default:  wmask <= 4'b0000; 
+        endcase
+      end
+    end
+    else begin
+      wdata_real <= 32'b0;
+      wmask <= 4'b0;
+    end
+  end  
+
+  psram_cmd psram_cmd_i(
+    .clock(sck),
+    .reset(reset),
+    .valid(valid),
+    .cmd(cmd),
+    .addr(rwaddr),
+    .rdata(rdata),
+    .wdata(wdata_real),
+    .wmask(wmask)
+  );
+
+  always@(posedge sck or posedge reset) begin
+    if((state == addr_t) && (counter == 8'd0)) begin
+      if (cmd == 8'h35)       qpi_mode <= 1'b1;
+      else if (cmd == 8'hf5)  qpi_mode <= 1'b0;  
+    end 
+  end
+
+  always@(posedge sck or posedge reset) begin
+    if (reset) begin   
+      state <= cmd_t;
+    end
+    else begin
+      case (state)
+        cmd_t:    state <=  (counter == (qpi_mode ? 8'd4 : 8'd7)) ? addr_t : state;
+        addr_t:   state <=  (cmd == 8'h35 || cmd == 8'hf5) ? cmd_t :    // 模式控制命令，不需要后续信号
+                            (cmd != 8'hEB && cmd != 8'h38) ? err_t :    
+                            (counter == 8'd20) ? ((cmd == 8'hEB) ? delay_t : w_data_t) : state;  // 读数据时要先进delay状态  
+        delay_t:  state <=  (counter == 8'd6 ) ? r_data_t : state;       
+        r_data_t, w_data_t: 
+                  state <=  state;
+
+        default: begin
+          state <= state;
+          $fwrite(32'h80000002, "Assertion failed: Unsupport command `%xh`, only support `EBh` read command and `38h` write command\n", cmd);
+          $fatal;
+        end
+      endcase
+    end
+  end
+
+  always@(posedge sck or posedge reset) begin
+    if (reset) counter <= 8'd0;
+    else begin
+      case (state)
+        cmd_t:   counter <= qpi_mode ? ((counter < 8'd4 ) ? counter + 8'd4 : 8'd0) : 
+                                       ((counter < 8'd7 ) ? counter + 8'd1 : 8'd0);
+        addr_t:  counter <= (counter < 8'd20) ? counter + 8'd4 : 8'd0;
+        delay_t: counter <= (counter < 8'd6 ) ? counter + 8'd1 : 8'd0;
+        default: counter <=  counter + 8'd4;
+      endcase
+    end
+  end
+
+  always@(posedge sck or posedge reset) begin
+    if (reset)               cmd <= 8'd0;
+    else if (state == cmd_t) begin
+      if(qpi_mode)
+        cmd <= { cmd[3:0], dio };
+      else
+        cmd <= { cmd[6:0], dio[0] };
+    end
+  end
+
+  always@(posedge sck or posedge reset) begin
+    if (reset) addr <= 24'd0;
+    else if (state == addr_t && counter < 8'd24)
+      addr <= { addr[19:0], dio };
+  end
+
+  wire [31:0] rdata_bswap = {rdata[7:0], rdata[15:8], rdata[23:16], rdata[31:24]};
+  always@(posedge sck or posedge reset) begin
+    if (reset) data <= 32'd0;
+    else if (state == r_data_t) begin
+      data <= { {counter == 8'd0 ? rdata_bswap : data}[27:0], 4'b0 };
+    end
+    else if (state == w_data_t) begin
+      if(counter < 8'd28)
+        data <= { data[27:0], dio };
+    end
+  end
+
+  assign wdata = (state == w_data_t) ? {data[3:0], dio, data[11:4], data[19:12], data[27:20]} : 32'b0;
+  assign dio = (ce_n || (state != r_data_t)) ? 4'bz : ({(state == r_data_t && counter == 8'd0) ? rdata_bswap : data}[31:28]);
+
+endmodule
+
+import "DPI-C" function void psram_read(input int addr, output int data);
+import "DPI-C" function void psram_write(input int addr, input int data, input int wmask);
+
+module psram_cmd(
+  input             clock,
+  input             reset,
+  input             valid,
+  input       [7:0] cmd,
+  input      [31:0] addr,
+  input      [31:0] wdata,
+  input      [3:0]  wmask,
+  output reg [31:0] rdata
+);
+
+  wire [31:0] full_wmask;
+  assign full_wmask = {{8{wmask[3]}}, {8{wmask[2]}}, {8{wmask[1]}}, {8{wmask[0]}}};
+
+  always@(posedge clock or posedge reset) begin
+    if(reset) begin
+      if (cmd == 8'h38) begin
+        psram_write(addr, wdata, full_wmask); // Quad IO Write
+      end
+    end
+    if (valid)
+      if (cmd == 8'hEB) begin
+        psram_read(addr, rdata); // Qual IO Read
+      end
+      // else if (cmd == 8'h38) begin
+      //   psram_write(addr, wdata); // Quad IO Write
+      // end
+      // else begin
+      //   $fwrite(32'h80000002, "Assertion failed: Unsupport command `%xh`, only support `EBh` read command and `38h` write command\n", cmd);
+      //   $fatal;
+      // end
+  end
 endmodule
