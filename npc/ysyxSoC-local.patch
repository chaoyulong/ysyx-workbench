+  );
+
+  vga_sram vga_sram_i(
+    .clk(clock),
+    .rst(reset),
+    .w_en(in_psel && in_penable && in_pwrite),
+    .waddr(vga_sram_addr),
+    .wdata(in_pwdata),
+    .wmask(in_pstrb),
