diff --git a/perip/amba/apb_delayer.v b/perip/amba/apb_delayer.v
index c0d20764..79f592ca 100644
--- a/perip/amba/apb_delayer.v
+++ b/perip/amba/apb_delayer.v
@@ -1,3 +1,9 @@
+`define R 3.76
+`define S 128
+`define S_LENGTH 7
+
+`define MUL 32'd481      // r * s, r可以为小数，s = 128，结果取整
+
 module apb_delayer(
   input         clock,
   input         reset,
@@ -24,15 +30,66 @@ module apb_delayer(
   input         out_pslverr
 );
 
+  typedef enum [1:0] { wait_t, data_t, delay_t, out_t} state_t;
+  reg [ 1:0] state;
+  reg [31:0] counter;
+
+  reg        reg_pready;
+  reg [31:0] reg_prdata;
+  reg        reg_pslverr;
+
+  // assign out_paddr   = in_paddr;
+  // assign out_psel    = in_psel;
+  // assign out_penable = in_penable;
+  // assign out_pprot   = in_pprot;
+  // assign out_pwrite  = in_pwrite;
+  // assign out_pwdata  = in_pwdata;
+  // assign out_pstrb   = in_pstrb;
+  // assign in_pready   = out_pready;
+  // assign in_prdata   = out_prdata;
+  // assign in_pslverr  = out_pslverr;
+
+  always@(posedge clock) begin
+    if (reset) state <= wait_t;
+    else begin
+      case (state)
+        wait_t: state <= in_psel    ? data_t  : state;
+        data_t: state <= out_pready ? delay_t : state;    // 已通信完成，需延迟返回ready信号
+        delay_t:state <= (counter == 32'd0) ? out_t : state;
+        out_t:  state <= wait_t;
+      endcase
+    end
+  end
+
+  always@(posedge clock) begin
+    if (reset) counter <= 32'd0;
+    else begin
+      case (state)
+        data_t:   counter <= (out_pready) ? {`S_LENGTH'b0, counter[31:`S_LENGTH]} : (counter + `MUL);
+        delay_t:  counter <= (counter > 32'd0) ? counter - 32'd1 : 32'd0;
+        default:  counter <= 32'd0;
+      endcase
+    end
+  end
+
+  always@(posedge clock) begin
+    if(out_pready) begin
+      reg_prdata <= out_prdata;
+      reg_pslverr <= out_pslverr;
+    end
+  end
+
+
   assign out_paddr   = in_paddr;
-  assign out_psel    = in_psel;
-  assign out_penable = in_penable;
+  assign out_psel    = (state == wait_t | state == data_t) ? in_psel : 1'b0;
+  assign out_penable = (state == wait_t | state == data_t) ? in_penable : 1'b0;
   assign out_pprot   = in_pprot;
   assign out_pwrite  = in_pwrite;
   assign out_pwdata  = in_pwdata;
   assign out_pstrb   = in_pstrb;
-  assign in_pready   = out_pready;
-  assign in_prdata   = out_prdata;
-  assign in_pslverr  = out_pslverr;
+
+  assign in_pready   = (state == out_t) ? 1'b1 : 1'b0;
+  assign in_prdata   = (state == out_t) ? reg_prdata : 32'b0;
+  assign in_pslverr  = (state == out_t) ? reg_pslverr: 1'b0;
 
 endmodule
