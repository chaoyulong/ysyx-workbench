+  // assign in_arready = out_arready;
+  // assign out_arvalid = in_arvalid;
+  // assign out_arid = in_arid;
+  // assign out_araddr = in_araddr;
+  // assign out_arlen = in_arlen;
+  // assign out_arsize = in_arsize;
+  // assign out_arburst = in_arburst;
+  // assign out_rready = in_rready;
+  // assign in_rvalid = out_rvalid;
+  // assign in_rid = out_rid;
+  // assign in_rdata = out_rdata;
+  // assign in_rresp = out_rresp;
+  // assign in_rlast = out_rlast;
+  // assign in_awready = out_awready;
+  // assign out_awvalid = in_awvalid;
+  // assign out_awid = in_awid;
+  // assign out_awaddr = in_awaddr;
+  // assign out_awlen = in_awlen;
+  // assign out_awsize = in_awsize;
+  // assign out_awburst = in_awburst;
+  // assign in_wready = out_wready;
+  // assign out_wvalid = in_wvalid;
+  // assign out_wdata = in_wdata;
+  // assign out_wstrb = in_wstrb;
+  // assign out_wlast = in_wlast;
+  // assign out_bready = in_bready;
+  // assign in_bvalid = out_bvalid;
+  // assign in_bid = out_bid;
+  // assign in_bresp = out_bresp;
+
+  `define R 3.76
+  `define S 128
+  `define S_LENGTH 7
+  `define MUL 32'd481      // r * s, r可以为小数，s = 128，结果取整
+  `define BEATS 8            // 突发节拍数上限，目前取8
+
+  // ================================== 读通道 ================================== //
+  reg        r_busy;                       
+  reg [31:0] r_acc;                        // 累加器: 每拍 += MUL
+  reg [31:0] r_now;                        // 距 t0 的真实拍数
+
+  reg [31:0] rf_data [0:`BEATS-1];         // 拍数据 FIFO
+  reg [ 3:0] rf_id   [0:`BEATS-1];
+  reg [ 1:0] rf_resp [0:`BEATS-1];
+  reg        rf_last [0:`BEATS-1];
+  reg [31:0] rf_tgt  [0:`BEATS-1];        // 每拍各自的交付时刻(绝对)
+  reg [ 2:0] rf_wp, rf_rp;                // 写指针和读指针
+  reg [ 3:0] rf_cnt;
+  reg        r_got_last;
+
+  wire r_start = in_arvalid && !r_busy;             // t0: arvalid有效作为开始
+  wire r_push  = r_busy && out_rvalid;              // 设备给数据, 立刻收下
+  wire r_pop   = in_rvalid && in_rready;            // CPU收下
+
+  always @(posedge clock) begin
+    if (r_push) begin
+      rf_data[rf_wp] <= out_rdata;
+      rf_id  [rf_wp] <= out_rid;
+      rf_resp[rf_wp] <= out_rresp;
+      rf_last[rf_wp] <= out_rlast;
+      rf_tgt [rf_wp] <= r_acc >> `S_LENGTH;   // ≈ 到达时刻 × R
+    end
+  end
+
+  always @(posedge clock) begin
+    if (reset) 
+      r_busy <= 1'b0;
+    else if (r_start) 
+      r_busy <= 1'b1;
+    else if (r_busy && r_got_last && (rf_cnt == 4'd0))   // 已经发送最后一个数据后清零
+      r_busy <= 1'b0;
+    else  
+      r_busy <= r_busy;
+  end
+
+  always @(posedge clock) begin
+    if (reset) begin
+      r_acc <= 32'd0;
+      r_now <= 32'd0;
+    end
+    else if (r_start) begin
+      r_acc  <= `MUL;     // t0这一拍也计入，否则整体差一拍
+      r_now  <= 32'd1;    // 实际周期数就是每次+1
+    end
+    else if (r_busy) begin
+      r_acc <= r_acc + `MUL;
+      r_now <= r_now + 32'd1;
+    end
+    else begin
+      r_acc <= r_acc;
+      r_now <= r_now;
+    end
+  end 
+
+  always @(posedge clock) begin
+    if (reset) 
+      rf_wp <= 3'd0;
+    else if (r_start) 
+      rf_wp <= 3'd0;
+    else if (r_push) 
+      rf_wp  <= rf_wp + 3'd1;
+    else  
+      rf_wp <= rf_wp;
+  end
+
+  always @(posedge clock) begin
+    if (reset) 
+      rf_rp <= 3'd0;
+    else if (r_start) 
+      rf_rp <= 3'd0;
+    else if (r_pop) 
+      rf_rp  <= rf_rp + 3'd1;
+    else  
+      rf_rp <= rf_rp;
+  end
+
+  always @(posedge clock) begin
+    if (reset) 
+      rf_cnt <= 4'd0;
+    else if (r_start) 
+      rf_cnt <= 4'd0;
+    else if (r_push && r_pop)   // 同拍一进一出, 数量不变
+      rf_cnt <= rf_cnt;
+    else if (r_push) 
+      rf_cnt <= rf_cnt + 4'd1;
+    else if (r_pop)
+      rf_cnt <= rf_cnt - 4'd1;
+    else
+      rf_cnt <= rf_cnt;
+  end
+
+  always @(posedge clock) begin
+    if (reset) 
+      r_got_last <= 1'b0;
+    else if (r_start) 
+      r_got_last <= 1'b0;
+    else if (r_push && out_rlast) // 最后一个数据
+      r_got_last <= 1'b1;
+    else  
+      r_got_last <= r_got_last;
+  end
+
+  assign out_rready = r_busy;                        // 设备给就收
+  assign in_rvalid  = r_busy && (rf_cnt != 4'd0) && (r_now >= rf_tgt[rf_rp]);
+  assign in_rdata   = rf_data[rf_rp];
+  assign in_rid     = rf_id  [rf_rp];
+  assign in_rresp   = rf_resp[rf_rp];
+  assign in_rlast   = rf_last[rf_rp];
+
+  // ================================== 写通道 ================================== //
+  // AXI的写事务无论多少拍只有一个B响应, 所以不需要FIFO
+  reg        w_busy;                       
+  reg [31:0] w_acc;                        // 累加器: 每拍 += MUL
+  reg [31:0] w_now;                        // 距 t0 的真实拍数
+  reg        b_pending;                    // B响应已收到, 等待交付
+  reg [31:0] b_tgt;                        // B响应的交付时刻(绝对)
+  reg [ 3:0] b_id_r;
+  reg [ 1:0] b_resp_r;
+
+  wire w_start = (in_awvalid || in_wvalid) && !w_busy;   // t0: aw/w有效作为开始
+  wire b_push  = w_busy && out_bvalid && !b_pending;     // 设备给响应, 立刻收下
+  wire b_pop   = in_bvalid && in_bready;                 // CPU收下
+
+  always @(posedge clock) begin
+    if (reset) 
+      w_busy <= 1'b0;
+    else if (w_start) 
+      w_busy <= 1'b1;
+    else if (b_pop)                    // B响应交付完成, 事务结束
+      w_busy <= 1'b0;
+    else  
+      w_busy <= w_busy;
+  end
+
+  always @(posedge clock) begin
+    if (reset) begin
+      w_acc <= 32'd0;
+      w_now <= 32'd0;
+    end
+    else if (w_start) begin
+      w_acc <= `MUL;     // t0这一拍也计入，否则整体差一拍
+      w_now <= 32'd1;    // 实际周期数就是每次+1
+    end
+    else if (w_busy) begin
+      w_acc <= w_acc + `MUL;
+      w_now <= w_now + 32'd1;
+    end
+    else begin
+      w_acc <= w_acc;
+      w_now <= w_now;
+    end
+  end
+
+  always @(posedge clock) begin
+    if (reset) 
+      b_pending <= 1'b0;
+    else if (w_start) 
+      b_pending <= 1'b0;
+    else if (b_push) 
+      b_pending <= 1'b1;
+    else if (b_pop)  
+      b_pending <= 1'b0;
+    else  
+      b_pending <= b_pending;
+  end
+
+  always @(posedge clock) begin
+    if (b_push) begin
+      b_tgt    <= w_acc >> `S_LENGTH;   // ≈ 到达时刻 × R
+      b_id_r   <= out_bid;
+      b_resp_r <= out_bresp;
+    end
+  end
+
+  assign out_bready = w_busy;                            // 设备给就收
+  assign in_bvalid  = b_pending && (w_now >= b_tgt);
+  assign in_bid     = b_id_r;
+  assign in_bresp   = b_resp_r;
+
+  // ============================== 直通通道 ============================== //
+  assign in_arready   = out_arready;
+  assign out_arvalid  = in_arvalid;
+  assign out_arid     = in_arid;
+  assign out_araddr   = in_araddr;
+  assign out_arlen    = in_arlen;
+  assign out_arsize   = in_arsize;
+  assign out_arburst  = in_arburst;
+
+  assign in_awready   = out_awready;
+  assign out_awvalid  = in_awvalid;
+  assign out_awid     = in_awid;
+  assign out_awaddr   = in_awaddr;
+  assign out_awlen    = in_awlen;
+  assign out_awsize   = in_awsize;
+  assign out_awburst  = in_awburst;
+
+  assign in_wready    = out_wready;
+  assign out_wvalid   = in_wvalid;
+  assign out_wdata    = in_wdata;
+  assign out_wstrb    = in_wstrb;
+  assign out_wlast    = in_wlast;
 
 endmodule
diff --git a/perip/gpio/gpio_top_apb.v b/perip/gpio/gpio_top_apb.v
index ec51ffe5..0ac48030 100644
--- a/perip/gpio/gpio_top_apb.v
+++ b/perip/gpio/gpio_top_apb.v
@@ -23,5 +23,72 @@ module gpio_top_apb(
   output [7:0]  gpio_seg_6,
   output [7:0]  gpio_seg_7
 );
+  wire [3:0] gpio_addr = in_paddr[3:0];
 
+  reg [15:0] gpio_out_reg;
+  reg [15:0] gpio_in_reg;
+  reg [31:0] gpio_seg_reg;
+
+  assign in_pready = in_psel && in_penable;
+  assign in_pslverr = 1'b0;
+
+
+  
+  always @(posedge clock or posedge reset) begin
+    if(reset)
+      gpio_out_reg <= 16'h0;
+    else if((gpio_addr == 4'h0) && in_psel && in_penable && in_pwrite) begin    // 写16个LED的状态
+      gpio_out_reg <= in_pwdata[15:0];
+    end
+    // else if((gpio_addr == 4'h4) && in_psel && in_penable && ~in_pwrite) begin    // 读16个拨码开关的状态
+    //   gpio_in_reg <= gpio_in;
+    // end
+    else if((gpio_addr == 4'h8) && in_psel && in_penable && in_pwrite) begin    // 写8个数码管的数字
+      gpio_seg_reg <= in_pwdata;
+    end
+  end
+
+  assign in_prdata = {16'b0, gpio_in};
+  assign gpio_out = gpio_out_reg;
+ 
+  seg7 seg7_0(gpio_seg_reg[ 3: 0], gpio_seg_0); 
+  seg7 seg7_1(gpio_seg_reg[ 7: 4], gpio_seg_1);
+  seg7 seg7_2(gpio_seg_reg[11: 8], gpio_seg_2);
+  seg7 seg7_3(gpio_seg_reg[15:12], gpio_seg_3);
+  seg7 seg7_4(gpio_seg_reg[19:16], gpio_seg_4);
+  seg7 seg7_5(gpio_seg_reg[23:20], gpio_seg_5);
+  seg7 seg7_6(gpio_seg_reg[27:24], gpio_seg_6);
+  seg7 seg7_7(gpio_seg_reg[31:28], gpio_seg_7); 
+  
+endmodule
+
+module seg7(
+  input  [3:0] dis_num,
+  output [7:0] seg_out
+);
+  reg [7:0] seg_out_reg;
+
+  always @(*) begin
+    case (dis_num)
+        4'h0 : seg_out_reg = 8'b00000011;
+        4'h1 : seg_out_reg = 8'b10011111;
+        4'h2 : seg_out_reg = 8'b00100101;
+        4'h3 : seg_out_reg = 8'b00001101;
+        4'h4 : seg_out_reg = 8'b10011001;
+        4'h5 : seg_out_reg = 8'b01001001;
+        4'h6 : seg_out_reg = 8'b01000001;
+        4'h7 : seg_out_reg = 8'b00011111;
+        4'h8 : seg_out_reg = 8'b00000001;
+        4'h9 : seg_out_reg = 8'b00001001;
+        4'ha : seg_out_reg = 8'b00010001;
+        4'hb : seg_out_reg = 8'b11000001;
+        4'hc : seg_out_reg = 8'b01100011;
+        4'hd : seg_out_reg = 8'b10000101;
+        4'he : seg_out_reg = 8'b01100001;
+        4'hf : seg_out_reg = 8'b01110001;
+        default: seg_out_reg = 8'b11111111;
+    endcase
+  end
+
+  assign seg_out = seg_out_reg;
