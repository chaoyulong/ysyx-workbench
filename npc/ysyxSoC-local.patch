diff --git a/perip/ps2/ps2_top_apb.v b/perip/ps2/ps2_top_apb.v
index 080d38fa..f6c9d5d1 100644
--- a/perip/ps2/ps2_top_apb.v
+++ b/perip/ps2/ps2_top_apb.v
@@ -16,4 +16,103 @@ module ps2_top_apb(
   input         ps2_data
 );
 
+  wire [2:0] keyboad_addr = in_paddr[2:0];
+  wire overflow;
+  wire [7:0] keyboard_data;
+  wire       keyboard_ready;
+  reg nextdata_n;
+  wire clear;
+
+  assign clear = reset | overflow;
+
+  always @(posedge clock or posedge reset) begin
+    if(reset) begin
+      nextdata_n <= 1'b1;
+    end  
+    else if(!nextdata_n) begin    // 置0时下一周期立即置高
+      nextdata_n <= 1'b1;
+    end   
+    // else if(overflow)
+    //   nextdata_n <= 1'b0;
+    else if(in_psel && in_penable && ~in_pwrite && keyboard_ready) begin    // 读取一个键盘值
+      nextdata_n <= 1'b0;
+      // $display("read data = %x", in_prdata);
+    end
+  end
+
+  ps2_keyboard ps2_keyboard_i(
+    .clk       (clock), 
+    .clr       (clear), 
+    .ps2_clk   (ps2_clk), 
+    .ps2_data  (ps2_data), 
+    .nextdata_n(nextdata_n),
+    .data      (keyboard_data), 
+    .ready     (keyboard_ready), 
+    .overflow  (overflow)     // fifo overflow
+  );
+
+  assign in_pslverr = 1'b0;
+  assign in_pready = in_psel && in_penable;
+  assign in_prdata = keyboard_ready ? {24'b0, keyboard_data} : 32'b0;
+
+endmodule
+
+module ps2_keyboard(
+  input clk,
+  input clr,
+  input ps2_clk,
+  input ps2_data,
+  input nextdata_n,
+  output [7:0] data,
+  output reg ready,
+  output reg overflow     // fifo overflow
+);
+  // internal signal, for test
+  reg [9:0] buffer;        // ps2_data bits
+  reg [7:0] fifo[15:0];     // data fifo
+  reg [3:0] w_ptr,r_ptr;   // fifo write and read pointers
+  reg [3:0] count;  // count ps2_data bits
+  // detect falling edge of ps2_clk
+  reg [2:0] ps2_clk_sync;
+
+  always @(posedge clk) begin
+    ps2_clk_sync <=  {ps2_clk_sync[1:0],ps2_clk};
+  end
+
+  wire sampling = ps2_clk_sync[2] & ~ps2_clk_sync[1];
+
+  always @(posedge clk) begin
+    if (clr) begin // reset
+      count <= 0; w_ptr <= 0; r_ptr <= 0; overflow <= 0; ready<= 0;
+    end
+    else begin
+      if(ready) begin // read to output next data
+        if(nextdata_n == 1'b0) //read next data
+        begin
+          r_ptr <= r_ptr + 4'b1;
+          if(w_ptr==(r_ptr+4'b1)) //empty
+            ready <= 1'b0;
+        end
+      end
+      if (sampling) begin
+        if (count == 4'd10) begin
+          if((buffer[0] == 0) &&  // start bit
+            (ps2_data)       &&  // stop bit
+            (^buffer[9:1])) begin      // odd  parity
+            fifo[w_ptr] <= buffer[8:1];  // kbd scan code
+            w_ptr <= w_ptr+4'b1;
+            ready <= 1'b1;
+            overflow <= overflow | (r_ptr == (w_ptr + 4'b1));
+          end
+          count <= 0;     // for next
+        end else begin
+          buffer[count] <= ps2_data;  // store ps2_data
+          count <= count + 3'b1;
+        end
+      end
+    end
+  end
+
+  assign data = fifo[r_ptr]; //always set output data
+
 endmodule
