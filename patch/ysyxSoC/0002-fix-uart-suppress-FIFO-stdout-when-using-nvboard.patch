From 18081645a42384873ef72e38f17120f517976b79 Mon Sep 17 00:00:00 2001
From: 23060082-ChaoYuLong <2324849716@qq.com>
Date: Sat, 7 Nov 2026 11:46:53 +0800
Subject: [PATCH] fix(uart): suppress FIFO stdout when using nvboard


diff --git a/perip/uart16550/rtl/uart_tfifo.v b/perip/uart16550/rtl/uart_tfifo.v
index 71329116..10231539 100644
--- a/perip/uart16550/rtl/uart_tfifo.v
+++ b/perip/uart16550/rtl/uart_tfifo.v
@@ -211,7 +211,9 @@ begin
             begin
                 top   <= #1 top_plus_1;
                 count <= #1 count + 1'b1;
+`ifndef __CI_MODE__
                 $write("%c", data_in);
+`endif
             end
         2'b01 : if(count>0)
             begin
@@ -221,7 +223,9 @@ begin
         2'b11 : begin
                 bottom <= #1 bottom + 1'b1;
                 top    <= #1 top_plus_1;
+`ifndef __CI_MODE__
                 $write("%c", data_in);
+`endif
                 end
         default: ;
         endcase
