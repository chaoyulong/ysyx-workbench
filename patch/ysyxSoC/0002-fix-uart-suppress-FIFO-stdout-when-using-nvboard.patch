From ec4e33b1c27da1ecc9878f2d2195dce97d56495d Mon Sep 17 00:00:00 2001
From: 23060082-ChaoYuLong <2324849716@qq.com>
Date: Sat, 7 Nov 2026 11:46:53 +0800
Subject: [PATCH] fix(uart): suppress FIFO stdout when using nvboard

---
 perip/uart16550/rtl/uart_tfifo.v | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/perip/uart16550/rtl/uart_tfifo.v b/perip/uart16550/rtl/uart_tfifo.v
index 71329116..99c72525 100644
--- a/perip/uart16550/rtl/uart_tfifo.v
+++ b/perip/uart16550/rtl/uart_tfifo.v
@@ -211,7 +211,9 @@ begin
             begin
                 top   <= #1 top_plus_1;
                 count <= #1 count + 1'b1;
+`ifndef __USE_NVBOARD__
                 $write("%c", data_in);
+ `endif
             end
         2'b01 : if(count>0)
             begin
@@ -221,7 +223,9 @@ begin
         2'b11 : begin
                 bottom <= #1 bottom + 1'b1;
                 top    <= #1 top_plus_1;
+`ifndef __USE_NVBOARD__
                 $write("%c", data_in);
+ `endif
                 end
         default: ;
         endcase
-- 
2.56.0

